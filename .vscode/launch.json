{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run GUI App (Interactive)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["-ui", "gui"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run CLI Search (A* MST)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "-mode", "search",
        "-map", "maps/map_co_ban.txt",
        "-algo", "astar",
        "-heuristic", "mst",
        "-ui", "cli"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run CLI Adversarial (Alpha-Beta)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "-mode", "adversarial",
        "-map", "maps/map_1ghost.txt",
        "-algo", "alphabeta",
        "-depth", "3",
        "-ui", "cli"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests"],
      "console": "integratedTerminal"
    }
  ]
}
